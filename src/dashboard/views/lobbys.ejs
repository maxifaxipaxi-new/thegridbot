<!DOCTYPE html>
<html lang="de">
<%- include('partials/head', { title: 'Lobbys & Games - the grid' }) %>
<body>
    <%- include('partials/sidebar', { currentPath: '/dashboard/lobbys' }) %>

    <div class="main-wrapper">
        <div class="top-bar">
            <div>
                <h1 class="page-title">🎮 Lobbys & Games Verwaltung</h1>
                <p style="color: var(--text-muted); font-size: 14px; margin-top: 4px;">Verwalte den Spiele-Katalog und Community-Vorschläge für Lobby-Alerts & Mitspieler-Suchen</p>
            </div>
        </div>

        <main class="main-content">
            <% if (locals.errorMsg) { %>
                <div class="alert alert-error" style="margin-bottom: 24px; padding: 16px; background: rgba(239, 68, 68, 0.1); border: 1px solid var(--danger); border-radius: 12px; color: #f8fafc;">
                    <i class="fa-solid fa-triangle-exclamation" style="color: var(--danger); margin-right: 8px;"></i> <%= errorMsg %>
                </div>
            <% } %>

            <% if (locals.successMsg) { %>
                <div class="alert alert-success" style="margin-bottom: 24px; padding: 16px; background: rgba(16, 185, 129, 0.1); border: 1px solid var(--success); border-radius: 12px; color: #f8fafc;">
                    <i class="fa-solid fa-check-circle" style="color: var(--success); margin-right: 8px;"></i> <%= successMsg %>
                </div>
            <% } %>

            <!-- Plattform-Hinweis Banner -->
            <div style="margin-bottom: 24px; padding: 16px; background: rgba(245, 158, 11, 0.1); border: 1px solid #f59e0b; border-radius: 12px; color: #f8fafc; display: flex; align-items: flex-start; gap: 12px;">
                <i class="fa-solid fa-circle-exclamation" style="color: #f59e0b; font-size: 20px; margin-top: 2px;"></i>
                <div style="font-size: 14px; line-height: 1.5;">
                    <strong style="color: #fbbf24; font-size: 15px;">Wichtige Namenskonvention:</strong><br>
                    Bitte trage Spiele mit der <b>exakten offiziellen Bezeichnung</b> von Steam, Epic Games, EA, Battle.net oder Ubisoft ein (z. B. <code>Counter-Strike 2</code>, <code>Apex Legends</code>, <code>Tom Clancy's Rainbow Six Siege</code>). Dadurch können Nutzer die Spiele beim Suchen und Abonnieren ohne Tippfehler auswählen.
                </div>
            </div>

            <!-- Lobby-Panel im Discord posten -->
            <div class="dashboard-card" style="margin-bottom: 32px; border-left: 4px solid var(--accent-color);">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
                    <div>
                        <h3 style="display: flex; align-items: center; gap: 8px; margin: 0 0 6px 0;">
                            <i class="fa-solid fa-paper-plane" style="color: var(--accent-color);"></i>
                            Lobby-Panel in Discord-Kanal posten
                        </h3>
                        <p style="color: var(--text-muted); font-size: 13px; margin: 0;">
                            Sendet das offizielle <b>🎮 Lobbys & Mitspieler</b> Control-Panel inklusive Buttons in den ausgewählten Kanal, pinnt es fest und richtet den dauerhaften <b>🔑・Lobby-Codes</b> Thread ein.
                        </p>
                    </div>
                    <% if (locals.currentLobbyChannelId) { %>
                        <div style="background: rgba(255, 165, 0, 0.1); border: 1px solid rgba(255, 165, 0, 0.3); border-radius: 8px; padding: 6px 12px; font-size: 12px; color: #ffa500; display: flex; align-items: center; gap: 6px;">
                            <i class="fa-solid fa-check"></i> Aktive Kanal-ID: <code><%= currentLobbyChannelId %></code>
                        </div>
                    <% } %>
                </div>

                <form action="/dashboard/lobbys/post-panel" method="POST">
                    <div style="display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: flex-end;">
                        <div class="form-group">
                            <label class="form-label" for="lobby-channel" style="font-weight: 600; font-size: 13px; margin-bottom: 6px; display: block;">
                                Discord-Kanal auswählen *
                            </label>
                            <select id="lobby-channel" name="channelId" class="form-control" required style="width: 100%; padding: 10px 14px; background: rgba(0,0,0,0.25); border: 1px solid var(--glass-border); border-radius: 8px; color: white;">
                                <option value="" disabled <%= !locals.currentLobbyChannelId ? 'selected' : '' %>>-- Bitte Discord-Kanal auswählen --</option>
                                <% (locals.channels || []).forEach(c => { %>
                                    <option value="<%= c.id %>" <%= (locals.currentLobbyChannelId === c.id) ? 'selected' : '' %>>
                                        # <%= c.name %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary" style="padding: 10px 24px; display: inline-flex; align-items: center; gap: 8px; height: 42px;">
                            <i class="fa-solid fa-share-from-square"></i> Panel jetzt posten
                        </button>
                    </div>
                </form>
            </div>

            <!-- Neues Spiel hinzufügen -->
            <div class="dashboard-card" style="margin-bottom: 32px;">
                <h3 style="margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
                    <i class="fa-solid fa-plus-circle" style="color: var(--accent-color);"></i>
                    Neues Spiel zum Katalog hinzufügen
                </h3>
                <form action="/dashboard/lobbys/games/add" method="POST">
                    <div style="display: grid; grid-template-columns: 2fr 1fr auto; gap: 16px; align-items: flex-end;">
                        <div class="form-group">
                            <label class="form-label" for="add-name" style="font-weight: 600; font-size: 13px; margin-bottom: 6px; display: block;">Spielname *</label>
                            <input type="text" id="add-name" name="name" class="form-control" placeholder="z. B. Counter-Strike 2" required style="width: 100%; padding: 10px 14px; background: rgba(0,0,0,0.25); border: 1px solid var(--glass-border); border-radius: 8px; color: white;">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="add-platform" style="font-weight: 600; font-size: 13px; margin-bottom: 6px; display: block;">Plattform</label>
                            <input type="text" id="add-platform" name="platform" class="form-control" placeholder="z. B. Steam, Epic, Crossplay" value="Steam" style="width: 100%; padding: 10px 14px; background: rgba(0,0,0,0.25); border: 1px solid var(--glass-border); border-radius: 8px; color: white;">
                        </div>
                        <button type="submit" class="btn btn-primary" style="padding: 10px 24px; display: inline-flex; align-items: center; gap: 8px; height: 42px;">
                            <i class="fa-solid fa-floppy-disk"></i> Spiel speichern
                        </button>
                    </div>
                </form>
            </div>

            <!-- Aktuelle Spiele -->
            <div class="dashboard-card" style="margin-bottom: 32px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <h3>
                        <i class="fa-solid fa-gamepad" style="color: var(--accent-color); margin-right: 8px;"></i>
                        Aktuelle Spiele im Katalog (<%= games.length %>)
                    </h3>
                    <span style="font-size: 13px; color: var(--text-muted);">
                        Verfügbar in <code>/gameslist</code> & im Lobby-Alerts Menü
                    </span>
                </div>

                <div class="table-container">
                    <table class="table" style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 1px solid var(--glass-border); color: var(--text-muted); font-size: 13px; text-transform: uppercase;">
                                <th style="padding: 12px 16px; text-align: left;">Spiel</th>
                                <th style="padding: 12px 16px; text-align: left;">Plattform</th>
                                <th style="padding: 12px 16px; text-align: left;">Eingetragen von</th>
                                <th style="padding: 12px 16px; text-align: right;">Aktionen</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (games && games.length > 0) { %>
                                <% games.forEach(g => { %>
                                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                                        <td style="padding: 16px; font-weight: 600;">
                                            🎮 <%= g.name %>
                                        </td>
                                        <td style="padding: 16px;">
                                            <span style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; padding: 4px 10px; border-radius: 8px; font-size: 12px; font-weight: 600;">
                                                <%= g.platform || 'Allgemein' %>
                                            </span>
                                        </td>
                                        <td style="padding: 16px; color: var(--text-muted); font-size: 13px;">
                                            <%= g.addedBy || 'System' %>
                                        </td>
                                        <td style="padding: 16px; text-align: right; white-space: nowrap;">
                                            <div style="display: flex; gap: 8px; justify-content: flex-end;">
                                                <button type="button" class="btn btn-secondary" onclick="openEditGameModal(<%= g.id %>, <%= JSON.stringify(g.name) %>, <%= JSON.stringify(g.platform) %>)" style="padding: 6px 12px; background: rgba(255,255,255,0.1); border: 1px solid var(--glass-border); border-radius: 8px; color: white; cursor: pointer;">
                                                    <i class="fa-solid fa-pen-to-square"></i> Bearbeiten
                                                </button>
                                                <form action="/dashboard/lobbys/games/delete" method="POST" onsubmit="return confirm('Möchtest du dieses Spiel wirklich aus dem Katalog löschen? Alle zugehörigen Alerts werden ebenfalls entfernt.');" style="display: inline;">
                                                    <input type="hidden" name="id" value="<%= g.id %>">
                                                    <button type="submit" class="btn btn-danger" style="padding: 6px 10px; background: rgba(239, 68, 68, 0.2); border: 1px solid var(--danger); color: #f87171; border-radius: 8px; cursor: pointer;" title="Löschen">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" style="text-align: center; padding: 40px; color: var(--text-muted);">
                                        Noch keine Spiele eingetragen. Lege oben dein erstes Spiel an!
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Community-Vorschläge (/gamevorschlagen) -->
            <div class="dashboard-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <h3>
                        <i class="fa-solid fa-inbox" style="color: var(--accent-color); margin-right: 8px;"></i>
                        Community-Vorschläge (<%= suggestions.length %>)
                    </h3>
                    <span style="font-size: 13px; color: var(--text-muted);">
                        Eingereicht via <code>/gamevorschlagen</code>
                    </span>
                </div>

                <div class="table-container">
                    <table class="table" style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 1px solid var(--glass-border); color: var(--text-muted); font-size: 13px; text-transform: uppercase;">
                                <th style="padding: 12px 16px; text-align: left;">Vorgeschlagenes Spiel</th>
                                <th style="padding: 12px 16px; text-align: left;">Plattform</th>
                                <th style="padding: 12px 16px; text-align: left;">User ID</th>
                                <th style="padding: 12px 16px; text-align: left;">Status</th>
                                <th style="padding: 12px 16px; text-align: right;">Aktionen</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (suggestions && suggestions.length > 0) { %>
                                <% suggestions.forEach(s => { %>
                                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                                        <td style="padding: 16px; font-weight: 600;">
                                            <%= s.name %>
                                        </td>
                                        <td style="padding: 16px; color: var(--text-muted);">
                                            <%= s.platform || 'Allgemein' %>
                                        </td>
                                        <td style="padding: 16px; color: var(--text-muted); font-size: 13px;">
                                            <%= s.userId %>
                                        </td>
                                        <td style="padding: 16px;">
                                            <% if (s.status === 'pending') { %>
                                                <span style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; padding: 4px 10px; border-radius: 8px; font-size: 12px; font-weight: 600;">Offen</span>
                                            <% } else if (s.status === 'approved') { %>
                                                <span style="background: rgba(34, 197, 94, 0.2); color: #4ade80; padding: 4px 10px; border-radius: 8px; font-size: 12px; font-weight: 600;">Angenommen</span>
                                            <% } else { %>
                                                <span style="background: rgba(239, 68, 68, 0.2); color: #f87171; padding: 4px 10px; border-radius: 8px; font-size: 12px; font-weight: 600;">Abgelehnt</span>
                                            <% } %>
                                        </td>
                                        <td style="padding: 16px; text-align: right; white-space: nowrap;">
                                            <div style="display: flex; gap: 8px; justify-content: flex-end;">
                                                <% if (s.status === 'pending') { %>
                                                    <form action="/dashboard/lobbys/suggestions/approve" method="POST" style="display: inline;">
                                                        <input type="hidden" name="id" value="<%= s.id %>">
                                                        <input type="hidden" name="name" value="<%= s.name %>">
                                                        <input type="hidden" name="platform" value="<%= s.platform %>">
                                                        <button type="submit" class="btn btn-primary" style="padding: 6px 12px; font-size: 12px;" title="Direkt annehmen">
                                                            <i class="fa-solid fa-check"></i> Annehmen
                                                        </button>
                                                    </form>
                                                    <button type="button" class="btn btn-secondary" onclick="openApproveEditModal(<%= s.id %>, <%= JSON.stringify(s.name) %>, <%= JSON.stringify(s.platform) %>)" style="padding: 6px 10px; font-size: 12px;" title="Bearbeiten & Annehmen">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </button>
                                                    <form action="/dashboard/lobbys/suggestions/reject" method="POST" style="display: inline;">
                                                        <input type="hidden" name="id" value="<%= s.id %>">
                                                        <button type="submit" class="btn btn-secondary" style="padding: 6px 10px; font-size: 12px; color: #f87171;" title="Ablehnen">
                                                            <i class="fa-solid fa-xmark"></i>
                                                        </button>
                                                    </form>
                                                <% } %>
                                                <form action="/dashboard/lobbys/suggestions/delete" method="POST" onsubmit="return confirm('Vorschlag endgültig löschen?');" style="display: inline;">
                                                    <input type="hidden" name="id" value="<%= s.id %>">
                                                    <button type="submit" class="btn btn-danger" style="padding: 6px 10px; font-size: 12px;" title="Löschen">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" style="text-align: center; padding: 40px; color: var(--text-muted);">
                                        Keine Community-Vorschläge vorhanden.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
        <%- include('partials/footer') %>
    </div>

    <!-- Edit Game Modal -->
    <div id="editGameModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 999; justify-content: center; align-items: center; backdrop-filter: blur(4px);">
        <div style="background: #1e293b; border: 1px solid var(--glass-border); border-radius: 16px; padding: 24px; max-width: 500px; width: 90%; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3 style="margin: 0; font-size: 18px; color: white;"><i class="fa-solid fa-pen-to-square" style="color: var(--accent-color); margin-right: 8px;"></i> Spiel bearbeiten</h3>
                <button type="button" onclick="closeEditGameModal()" style="background: none; border: none; color: var(--text-muted); font-size: 20px; cursor: pointer;">&times;</button>
            </div>
            <form action="/dashboard/lobbys/games/edit" method="POST">
                <input type="hidden" id="edit-game-id" name="id">
                <div class="form-group" style="margin-bottom: 16px;">
                    <label class="form-label" for="edit-game-name" style="font-weight: 600; font-size: 13px; margin-bottom: 6px; display: block; color: var(--text-main);">Spielname *</label>
                    <input type="text" id="edit-game-name" name="name" class="form-control" required style="width: 100%; padding: 10px 14px; background: rgba(0,0,0,0.25); border: 1px solid var(--glass-border); border-radius: 8px; color: white;">
                </div>
                <div class="form-group" style="margin-bottom: 24px;">
                    <label class="form-label" for="edit-game-platform" style="font-weight: 600; font-size: 13px; margin-bottom: 6px; display: block; color: var(--text-main);">Plattform</label>
                    <input type="text" id="edit-game-platform" name="platform" class="form-control" style="width: 100%; padding: 10px 14px; background: rgba(0,0,0,0.25); border: 1px solid var(--glass-border); border-radius: 8px; color: white;">
                </div>
                <div style="display: flex; justify-content: flex-end; gap: 12px;">
                    <button type="button" class="btn btn-outline" onclick="closeEditGameModal()" style="padding: 10px 20px; border: 1px solid var(--glass-border); background: transparent; color: white; border-radius: 8px; cursor: pointer;">Abbrechen</button>
                    <button type="submit" class="btn btn-primary" style="padding: 10px 20px;">Speichern</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Approve & Edit Suggestion Modal -->
    <div id="approveModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 999; justify-content: center; align-items: center; backdrop-filter: blur(4px);">
        <div style="background: #1e293b; border: 1px solid var(--glass-border); border-radius: 16px; padding: 24px; max-width: 500px; width: 90%; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3 style="margin: 0; font-size: 18px; color: white;"><i class="fa-solid fa-check" style="color: var(--success); margin-right: 8px;"></i> Vorschlag anpassen & freischalten</h3>
                <button type="button" onclick="closeApproveModal()" style="background: none; border: none; color: var(--text-muted); font-size: 20px; cursor: pointer;">&times;</button>
            </div>
            <form action="/dashboard/lobbys/suggestions/approve" method="POST">
                <input type="hidden" id="approve-id" name="id">
                <div class="form-group" style="margin-bottom: 16px;">
                    <label class="form-label" for="approve-name" style="font-weight: 600; font-size: 13px; margin-bottom: 6px; display: block; color: var(--text-main);">Offizieller Spielname *</label>
                    <input type="text" id="approve-name" name="name" class="form-control" required style="width: 100%; padding: 10px 14px; background: rgba(0,0,0,0.25); border: 1px solid var(--glass-border); border-radius: 8px; color: white;">
                </div>
                <div class="form-group" style="margin-bottom: 24px;">
                    <label class="form-label" for="approve-platform" style="font-weight: 600; font-size: 13px; margin-bottom: 6px; display: block; color: var(--text-main);">Plattform</label>
                    <input type="text" id="approve-platform" name="platform" class="form-control" style="width: 100%; padding: 10px 14px; background: rgba(0,0,0,0.25); border: 1px solid var(--glass-border); border-radius: 8px; color: white;">
                </div>
                <div style="display: flex; justify-content: flex-end; gap: 12px;">
                    <button type="button" class="btn btn-outline" onclick="closeApproveModal()" style="padding: 10px 20px; border: 1px solid var(--glass-border); background: transparent; color: white; border-radius: 8px; cursor: pointer;">Abbrechen</button>
                    <button type="submit" class="btn btn-primary" style="padding: 10px 20px;">Annehmen & Freischalten</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openEditGameModal(id, name, platform) {
            document.getElementById('edit-game-id').value = id;
            document.getElementById('edit-game-name').value = name;
            document.getElementById('edit-game-platform').value = platform || 'Steam';
            document.getElementById('editGameModal').style.display = 'flex';
        }

        function closeEditGameModal() {
            document.getElementById('editGameModal').style.display = 'none';
        }

        function openApproveEditModal(id, name, platform) {
            document.getElementById('approve-id').value = id;
            document.getElementById('approve-name').value = name;
            document.getElementById('approve-platform').value = platform || 'Steam';
            document.getElementById('approveModal').style.display = 'flex';
        }

        function closeApproveModal() {
            document.getElementById('approveModal').style.display = 'none';
        }

        window.onclick = function(event) {
            if (event.target === document.getElementById('editGameModal')) closeEditGameModal();
            if (event.target === document.getElementById('approveModal')) closeApproveModal();
        };
    </script>
</body>
</html>
